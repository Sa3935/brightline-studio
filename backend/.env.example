# Copy this file to .env and fill in real values. Never commit the real .env file.

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=app_db
# Set to "true" if your MySQL host requires SSL (most managed/cloud MySQL hosts do,
# e.g. PlanetScale, Railway, Aiven, AWS RDS with enforced SSL)
DB_SSL=false

# JWT
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=2h

# Server
PORT=5000
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173
